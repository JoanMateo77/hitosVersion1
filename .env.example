# Copiá este archivo como ".env" y completá con los valores de tu proyecto Supabase.
# Settings → API en el dashboard de Supabase.
#
# IMPORTANTE: la "anon key" es pública (va en el frontend). La seguridad real
# la dan las políticas RLS de supabase/schema.sql, no el ocultar esta clave.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
