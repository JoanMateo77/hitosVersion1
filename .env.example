# Copia este archivo como ".env" y completa con los valores de tu proyecto Supabase.
# Settings → API en el dashboard de Supabase.
#
# IMPORTANTE: la "anon key" es pública (va en el frontend). La seguridad real
# la dan las políticas RLS de supabase/schema.sql, no el ocultar esta clave.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# IA del coach: SOLO servidor (función /api/plan-meta). Sin prefijo VITE_ para
# que nunca llegue al navegador. En Vercel: Settings → Environment Variables.
# Si un modelo falla (503, 429, timeout, JSON inválido) se pasa al siguiente de
# la cadena; los eslabones de un proveedor sin clave se ignoran.
# Gemini: varias claves separadas por comas solo suman cuota si son de
# proyectos de Google distintos (la cuota es por proyecto).
GEMINI_API_KEY=
# Groq (console.groq.com/keys) y OpenRouter (openrouter.ai/keys), capas gratuitas.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Opcional: orden de la cadena "proveedor:modelo" separado por comas
# (proveedores: gemini, groq, openrouter). Vacío = cadena por defecto de
# src/server/aiChain.ts (DEFAULT_CHAIN).
AI_CHAIN=
# Opcional: modelo de Gemini a probar primero (se antepone a la cadena).
GEMINI_MODEL=
# Opcional: límite diario de pedidos de IA por usuario (por defecto 100).
AI_DAILY_LIMIT=
